@{
    Layout = null;
    int total = ViewBag.TotalTasks ?? 0;
    int completed = ViewBag.CompletedTasks ?? 0;
    int pending = ViewBag.PendingTasks ?? 0;
    int rate = ViewBag.CompletionRate ?? 0;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thống kê - FocusMate .NET 8</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            background-color: #fdf6f9;
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: #4a4049;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 0;
            padding: 20px;
        }
        .container-box {
            width: 100%;
            max-width: 1000px;
            background: rgba(255, 255, 255, 0.9);
            border-radius: 24px;
            padding: 30px;
            box-shadow: 0 10px 40px rgba(244, 194, 204, 0.25);
            border: 1px solid rgba(245, 208, 218, 0.6);
        }
        .stat-card {
            background: #fcf9fa;
            border: 1px solid #f5e1e8;
            border-radius: 20px;
            padding: 25px;
            text-align: center;
        }
        .back-btn {
            color: #d46a84;
            text-decoration: none;
            font-weight: 600;
        }
        .back-btn:hover {
            color: #c25571;
        }
    </style>
</head>
<body>
    <div class="container-box">
        <a href="@Url.Action("Index", "Home")" class="back-btn mb-3 d-inline-block"><i class="fas fa-arrow-left me-1"></i> Quay lại Dashboard</a>
        <h3 class="fw-bold mb-4" style="color: #5c4b51;"><i class="fas fa-chart-pie me-2" style="color: #d46a84;"></i>Thống Kê Hiệu Suất Hệ Thống</h3>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="stat-card">
                    <span class="text-muted fw-bold text-uppercase small">TỔNG NHIỆM VỤ</span>
                    <h2 class="fw-bold my-2" style="color: #5c4b51;">@total</h2>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <span class="text-muted fw-bold text-uppercase small">ĐÃ HOÀN THÀNH</span>
                    <h2 class="fw-bold my-2" style="color: #d46a84;">@completed</h2>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <span class="text-muted fw-bold text-uppercase small">ĐANG THỰC HIỆN</span>
                    <h2 class="fw-bold my-2" style="color: #e0a9b7;">@pending</h2>
                </div>
            </div>
        </div>

        <div class="mt-4 p-4 rounded-4 text-center" style="background: #fff5f7; border: 1px solid #ebd5dc;">
            <h5 class="fw-bold mb-2" style="color: #5c4b51;">Tỷ lệ thành công tổng thể</h5>
            <h1 class="fw-bold" style="color: #d46a84;">@rate%</h1>
        </div>
    </div>
</body>
</html>